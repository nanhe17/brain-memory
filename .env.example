# ---- Storage ----
# SQLite database file path
MEMORY_DB_PATH=./memory.db

# ---- Embedding provider ----
# "hash"              : deterministic feature-hashing embedder (offline, tests, fallback)
# "openai_compatible" : any OpenAI-compatible /embeddings endpoint
#                       (Zhipu GLM: base_url https://open.bigmodel.cn/api/paas/v4/ , model embedding-3)
MEMORY_EMBEDDING_PROVIDER=hash
MEMORY_EMBEDDING_MODEL=embedding-3
MEMORY_EMBEDDING_DIM=2048
MEMORY_API_BASE=https://open.bigmodel.cn/api/paas/v4
MEMORY_API_KEY=

# ---- Retrieval weights (each factor is normalized to [0,1] before weighting) ----
MEMORY_W_SEMANTIC=0.40
MEMORY_W_KEYWORD=0.15
MEMORY_W_RECENCY=0.15
MEMORY_W_IMPORTANCE=0.10
MEMORY_W_FREQUENCY=0.05
MEMORY_W_ENTITY=0.10
MEMORY_W_CONTEXT=0.05

# Recency half-life in days (exponential decay)
MEMORY_RECENCY_HALF_LIFE_DAYS=14.0

# ---- Optional LLM experience parser / query expansion / reranker ----
# One OpenAI-compatible endpoint serves all three (parser, expansion, rerank).
# Empty model/key = heuristic parser only, expansion and rerank disabled.
MEMORY_LLM_MODEL=
MEMORY_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MEMORY_LLM_API_KEY=

# auto = enabled whenever the LLM above is configured; off = force disable
MEMORY_QUERY_EXPANSION=auto
MEMORY_RERANK=auto
# Blind LLM rerank: candidates scored for topical relevance (content only),
# fused as final = mix*llm + (1-mix)*factor_score
MEMORY_RERANK_TOP_N=20
MEMORY_RERANK_MIX=0.4
MEMORY_RERANK_TIMEOUT=8

# ---- Phase 3: consolidation ----
# Episodes required before a concept group may become a semantic memory
MEMORY_CONSOLIDATION_MIN_SUPPORT=3
# Max semantic (consolidated knowledge) hits inside one recall
MEMORY_SEMANTIC_RECALL_LIMIT=3

# ---- Phase 4: reconsolidation ----
# Supporting episodes needed to rewrite an existing belief (lower than
# initial consolidation: reactive, anchored on an existing belief)
MEMORY_RECONSOLIDATION_MIN_SUPPORT=2

# ---- Phase 5: decay / forgetting ----
# active -> archived when memory strength (importance/recency/frequency/
# confidence blend) falls below this
MEMORY_DECAY_ARCHIVE_THRESHOLD=0.25
# archived -> forgotten after this many days without any touch
MEMORY_DECAY_FORGET_AFTER_DAYS=90

# ---- Phase 6: graph-aware recall (pattern completion) ----
# expand recall hits along graph edges (shared entities, evidence, concepts)
MEMORY_RECALL_EXPANSION=on
# expanded entries score anchor * penalty (keeps the original top-1 stable)
MEMORY_EXPANSION_PENALTY=0.6
# max expanded entries per recall
MEMORY_EXPANSION_LIMIT=4

# ---- Phase 7: PersonalizedPageRank (research extension) ----
# blend structural graph centrality into recall scores (final =
# (1-mix)*factor + mix*ppr); off by default - use brain-memory-eval to A/B
MEMORY_GRAPH_PPR=off
MEMORY_PPR_MIX=0.3
MEMORY_PPR_DAMPING=0.85
MEMORY_PPR_MAX_NODES=20000
