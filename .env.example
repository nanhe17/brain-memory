# ---- Storage ----
# SQLite database file path
MEMORY_DB_PATH=./memory.db

# ---- Embedding provider ----
# "hash"              : deterministic feature-hashing embedder (offline, tests, fallback)
# "openai_compatible" : any OpenAI-compatible /embeddings endpoint
#                       (Zhipu GLM: base_url https://open.bigmodel.cn/api/paas/v4/ , model embedding-3)
MEMORY_EMBEDDING_PROVIDER=hash
MEMORY_EMBEDDING_MODEL=embedding-3
MEMORY_EMBEDDING_DIM=2048
MEMORY_API_BASE=https://open.bigmodel.cn/api/paas/v4
MEMORY_API_KEY=

# ---- Retrieval weights (each factor is normalized to [0,1] before weighting) ----
MEMORY_W_SEMANTIC=0.40
MEMORY_W_KEYWORD=0.15
MEMORY_W_RECENCY=0.15
MEMORY_W_IMPORTANCE=0.10
MEMORY_W_FREQUENCY=0.05
MEMORY_W_ENTITY=0.10
MEMORY_W_CONTEXT=0.05

# Recency half-life in days (exponential decay)
MEMORY_RECENCY_HALF_LIFE_DAYS=14.0

# ---- Optional LLM experience parser (OpenAI-compatible /chat/completions) ----
# Empty = use the deterministic heuristic parser only
MEMORY_LLM_MODEL=
MEMORY_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MEMORY_LLM_API_KEY=
